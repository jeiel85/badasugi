{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "받아쓰기",
  "mainBinaryName": "badasugi",
  "identifier": "com.badasugi.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "받아쓰기",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 460,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "badasugi",
    "category": "Productivity",
    "copyright": "MIT License",
    "shortDescription": "가볍고 빠른 한국어 회의 전사 앱",
    "longDescription": "화자를 구분해 실시간으로 받아 적는 Windows 회의 전사 앱. 로컬 whisper.cpp 또는 OpenAI·Groq API.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RDI0NjlDNzE4OTk0QzcKUldUSGxJbHhuRWJTWnFnZDVlRHd2eG1RZnM4cXc2MEVMZHZDVkRSQzRSelhHT1A2WmhYRC9GZWoK",
      "endpoints": [
        "https://github.com/jeiel85/badasugi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}